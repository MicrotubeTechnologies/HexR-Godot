# Godot
.godot/
*.tmp

# Native build outputs (CI builds them; the release zip carries them)
/addons/hexr/android/bin/*.aar
/addons/hexr/bin/windows/*.dll
/addons/hexr/bin/windows/*.pdb
/android_plugin/.gradle/
/android_plugin/**/build/
/android_plugin/local.properties
/gdextension/**/*.obj
/gdextension/**/*.os
/gdextension/**/*.lib
/gdextension/**/*.exp
/gdextension/.sconsign*.dblite

# Test output
/tests/results*.xml

# Godot's Android build template (installed per machine by the export)
/android/
/build/
/override.cfg
/addons/hexr/bin/android/
/addons/hexr/bin/linux/
/addons/hexr/bin/macos/
